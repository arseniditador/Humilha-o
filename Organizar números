
#include <stdio.h>

int main() {
    int V[10] = {15, 26, 6731, 232, 111, 10, 21, 84, 43, 25};
    int tamanho = 10; 
    int temp; 

    for (int i = 0; i < tamanho - 1; i++) {
        for (int j = 0; j < tamanho - i - 1; j++) {
            if (V[j] > V[j + 1]) {
                temp = V[j];
                V[j] = V[j + 1];
                V[j + 1] = temp;
            }
        }
    }

    printf("Números organizados:\n");
    for (int i = 0; i < tamanho; i++) {
        printf("V[%d] = %d\n", i, V[i]);
    }

    return 0;
}
